# Only the Linear webhook is exposed publicly. Synapse reaches the appservice
# endpoints over localhost, so they never need to leave the machine.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name linear.chat.mementomori.social;

    ssl_certificate /etc/letsencrypt/live/linear.chat.mementomori.social/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linear.chat.mementomori.social/privkey.pem;

    add_header Strict-Transport-Security max-age=15768000;

    location = /linear/webhook {
        proxy_pass http://127.0.0.1:5055;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2M;
    }

    # Linear fetches this for the attachment icon under Resources.
    location = /matrix-icon.png {
        alias /opt/linear-matrix-bridge/public/matrix-icon.png;
        expires 30d;
    }

    location = /health {
        proxy_pass http://127.0.0.1:5055;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }

    access_log /var/log/nginx/linear-bridge-access.log;
    error_log /var/log/nginx/linear-bridge-error.log;
}

server {
    listen 80;
    listen [::]:80;
    server_name linear.chat.mementomori.social;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
