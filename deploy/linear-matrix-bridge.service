[Unit]
Description=linear-matrix-bridge: Linear issues to Matrix threads
After=network-online.target matrix-synapse.service
Wants=network-online.target

[Service]
Type=simple
User=rolle
Group=rolle
WorkingDirectory=/opt/linear-matrix-bridge

# The Rust crypto SDK needs Node 24 or newer, so the nvm build is pinned rather
# than /usr/bin/node. Update this path if the nvm version changes.
ExecStart=/home/rolle/.nvm/versions/node/v24.20.0/bin/node dist/server/index.js

Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5055
Environment=DATABASE_PATH=/opt/linear-matrix-bridge/data/bridge.db
Environment=MIGRATIONS_DIR=/opt/linear-matrix-bridge/migrations
Environment=BOT_STORAGE_PATH=/opt/linear-matrix-bridge/data/bot.json
Environment=CRYPTO_STORAGE_PATH=/opt/linear-matrix-bridge/data/crypto
Environment=MATRIX_HOMESERVER_NAME=chat.mementomori.social
Environment=MATRIX_ICON_URL=https://linear.chat.mementomori.social/matrix-icon.png

# Tokens live here, mode 600, never in the unit and never in git.
EnvironmentFile=/opt/linear-matrix-bridge/.env

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/linear-matrix-bridge/data

[Install]
WantedBy=multi-user.target
